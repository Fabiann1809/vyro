# Copy to .env.local (ignored by git) and fill in. Both values are read when the app is built.
# The address and the publishable key (sb_publishable_...) are public by design. NEVER put the
# secret / service key (sb_secret_... or the service_role JWT) here or anywhere in this repository.
MAIN_VITE_SUPABASE_URL=https://your-project-ref.supabase.co
MAIN_VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
